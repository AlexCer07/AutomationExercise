<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="login" verbose="1">


    <listeners>
        <listener class-name="Listeners.TestListener"/>
    </listeners>

    <test name="Login Tests">

        <groups>
            <run>
                <include name="login"/>
            </run>
        </groups>

        <classes>
            <class name="Test.LogInModule"/>
        </classes>

    </test>

</suite>