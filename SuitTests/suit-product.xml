<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="product" verbose="1">

    <listeners>
        <listener class-name="Listeners.TestListener"/>
    </listeners>

    <test name="Product Tests">

        <groups>
            <run>
                <include name="product"/>
            </run>
        </groups>

        <classes>
            <class name="Test.ProductsModule"/>
        </classes>

    </test>

</suite>